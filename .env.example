# Copy to .env for Docker Compose. For local Python, export these variables.
# Leave the bucket empty to use model folders already present in MODEL_DIR.
AWS_S3_BUCKET=
AWS_DEFAULT_REGION=eu-north-1
AWS_S3_MODEL_PREFIX=ml-models
MODEL_DIR=ml-model-dir
# The Streamlit server sends requests to this address.
API_URL=http://localhost:8000/api/v1/
# Use 0.0.0.0 only when deliberately exposing the demo on a server.
BIND_ADDRESS=127.0.0.1
